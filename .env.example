# Required for local dev and baked into production builds (Amplify / Vercel env).
# Use HTTPS for anything beyond local lab.

NEXT_PUBLIC_API_BASE_URL=https://identity-api.example.com
IDENTITY_API_KEY=api-key-to-interact-with-API
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/POOL_ID
COGNITO_DOMAIN=ida-emisor-dev-xxxxx.auth.us-east-1.amazoncognito.com

# Tenant branding (Amplify per-app)
NEXT_PUBLIC_TENANT_NAME=Issuer Portal
NEXT_PUBLIC_PRIMARY_COLOR=#0B3D6E
NEXT_PUBLIC_PRIMARY_DARK_COLOR=#062847
NEXT_PUBLIC_ACCENT_COLOR=#C5A028
NEXT_PUBLIC_BACKGROUND_COLOR=#F5F7FA
NEXT_PUBLIC_TEXT_COLOR=#1A1A1A
# Optional: absolute URL or /images/... path
NEXT_PUBLIC_LOGO_HEADER_URL=/images/logo-zijin.svg
NEXT_PUBLIC_LOGO_FOOTER_URL=/images/logo-zijin-white.svg
